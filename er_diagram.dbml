
Table users {
  user_id int [pk, increment]
  full_name varchar(100) [not null]
  email varchar(150) [unique, not null]
  password_hash varchar(255) [not null]
  created_at timestamp
}

Table budgets {
  budget_id int [pk, increment]
  user_id int [not null]
  budget_name varchar(100) [not null]
  amount decimal(12,2) [not null]
  start_date date
  end_date date
}

Table categories {
  category_id int [pk, increment]
  user_id int [not null]
  category_name varchar(100) [not null]
}

Table expenses {
  expense_id int [pk, increment]
  user_id int [not null]
  budget_id int [not null]
  category_id int [not null]
  amount decimal(12,2) [not null]
  description text
  expense_date date
}

Table savings_goals {
  goal_id int [pk, increment]
  user_id int [not null]
  goal_name varchar(100) [not null]
  target_amount decimal(12,2) [not null]
  target_date date
}

Table savings_contributions {
  contribution_id int [pk, increment]
  goal_id int [not null]
  user_id int [not null]
  amount decimal(12,2) [not null]
  contribution_date date
}

Table audit_logs {
  audit_id int [pk, increment]
  user_id int
  table_name varchar(100) [not null]
  record_id int
  action varchar(20) [not null]
  changed_at timestamp
  old_data jsonb
  new_data jsonb
}

Ref: budgets.user_id > users.user_id
Ref: categories.user_id > users.user_id
Ref: expenses.user_id > users.user_id
Ref: expenses.budget_id > budgets.budget_id
Ref: expenses.category_id > categories.category_id
Ref: savings_goals.user_id > users.user_id
Ref: savings_contributions.user_id > users.user_id
Ref: savings_contributions.goal_id > savings_goals.goal_id
Ref: audit_logs.user_id > users.user_id
